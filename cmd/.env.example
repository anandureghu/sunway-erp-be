# Optional overrides for cmd tools. Backend root ../.env is loaded first.
# Copy to .env only if you need different credentials than the app.

# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hrdb
# DB_USER=root
# DB_PASS=

# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_PUBLIC_CONTAINER=erp-public
# AZURE_PRIVATE_CONTAINER=erp-private

# --- Mail (SMTP) — required for OTP, enquiries, invoices, payslips ---
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=          # use an app password for Gmail/Microsoft, not the account login
# MAIL_FROM=              # usually same as MAIL_USERNAME (or allowed alias)
# ENQUIRY_TO=info@q7softwaresolutions.com
# SUBSCRIPTION_ALERT_EMAIL=

# Set to 1 to allow destructive ops against non-local DB hosts
# ALLOW_DESTRUCTIVE_OPS=0
